# -------------------------------------
# Application
# -------------------------------------

APP_NAME=ScamScope API
APP_ENV=development
APP_VERSION=1.0.0


# -------------------------------------
# Gemini configuration
# -------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120


# -------------------------------------
# Reputation APIs
# -------------------------------------

VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=


# -------------------------------------
# Application settings
# -------------------------------------

DEMO_MODE=true

MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=5

TOOL_TIMEOUT_SECONDS=8
